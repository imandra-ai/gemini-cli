{
  "experimental": {
    "extensionReloading": true,
    "modelSteering": true,
    "autoMemory": true,
    "topicUpdateNarration": true,
    "voiceMode": true,
    "adk": {
      "agentSessionNoninteractiveEnabled": true
    }
  },
  "general": {
    "devtools": true
  },
  "hooks": {
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "name": "imandra-nudge",
            "type": "command",
            "description": "After editing logic-bearing source, prompt the agent to formally check it with Imandra/CodeLogician.",
            "command": "$GEMINI_PROJECT_DIR/.gemini/hooks/imandra-nudge.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
